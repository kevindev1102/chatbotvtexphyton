PORT=8080

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1

VTEX_BASE_URL=https://coolboxpe.vtexcommercestable.com.br
VTEX_APP_KEY=
VTEX_APP_TOKEN=

COOLBOX_WEB_API_BASE_URL=
COOLBOX_WEB_API_USERNAME=
COOLBOX_WEB_API_PASSWORD=

HTTP_CONNECT_TIMEOUT_SECONDS=5
HTTP_RESPONSE_TIMEOUT_SECONDS=15

RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# Compose uses http://qdrant:6333 internally; this default is for local Python execution.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
SODIMAC_COLLECTION_ALIAS=sodimac_ces
SODIMAC_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
SODIMAC_MIN_VECTOR_SCORE=0.35
SODIMAC_OCR_LANGUAGE=spa+eng
# Optional when running Python outside Docker:
# FASTEMBED_CACHE_PATH=.cache/embeddings
# SODIMAC_REPORTS_PATH=documents/sodimac/reports
